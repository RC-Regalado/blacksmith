# Runtime
AI_ASSISTANT_PROVIDER=ollama
AI_ASSISTANT_MODEL=blacksmith-tools
AI_ASSISTANT_BASE_URL=http://localhost:11434
AI_ASSISTANT_REQUEST_TIMEOUT=240

# Provider-neutral context/generation budget.
# Bootstrap resolves these once; Ollama translates them to num_ctx/num_predict.
AI_ASSISTANT_MODEL_CONTEXT_WINDOW=2048
AI_ASSISTANT_MODEL_MAX_OUTPUT_TOKENS=512
AI_ASSISTANT_MODEL_CONTEXT_SAFETY_MARGIN=0

# Tools
AI_ASSISTANT_WORKSPACE=/path/to/workspace
AI_ASSISTANT_TOOL_EXECUTION=true
AI_ASSISTANT_TOOL_EXECUTOR=unix_socket
AI_ASSISTANT_TOOL_SOCKET=/tmp/blacksmith-toolserver.sock
AI_ASSISTANT_TOOL_LOG_DIR=logs/tools

# Storage
AI_ASSISTANT_DATABASE=assistant.sqlite3
AI_ASSISTANT_EXECUTION_DATABASE=assistant_execution.sqlite3
AI_ASSISTANT_KNOWLEDGE_DATABASE=assistant_knowledge.sqlite3
AI_ASSISTANT_AUDIT_DATABASE=assistant_audit.sqlite3
